<Project>

    <!--
      Tüm projelerin paket sürümleri burada tek yerden yönetilir (Central Package Management).
      .csproj dosyalarındaki PackageReference'larda Version yazılmaz.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- ASP.NET Core / EF Core (.NET 10) -->
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
        <!-- Npgsql yalnızca 10.0.4 ister; EF Core'un geri kalanıyla aynı sürümde kalsın -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />

        <!-- MediatR 13+ ücretli lisansa geçti; 12.5.0 Apache lisanslı son sürüm. -->
        <PackageVersion Include="MediatR" Version="12.5.0" />
        <!-- AutoMapper yerine (MIT). Ayarlar: Core/HappyDay.Application/Mapping/MapsterConfiguration.cs -->
        <PackageVersion Include="Mapster" Version="10.0.13" />

        <PackageVersion Include="FluentValidation" Version="12.2.0" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
        <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />

        <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
        <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageVersion Include="MailKit" Version="4.18.2" />

        <!-- Testler (Tests/HappyDay.Tests) -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

</Project>
