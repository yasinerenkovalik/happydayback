{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "PasswordWorkFactor": 12
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "yourdomain.com",
    "Audience": "yourdomain.com",
    "ExpirationInMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "CookieSameSite": "Strict"
  },
  "ConnectionStrings": {
    "DefaultConnection": "UseFromSecretsOrEnv"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}