# Coolify > API kaynağı > Environment Variables > "Developer view" alanına yapıştırın, <...> yerlerini doldurun.
# Bu dosyaya gerçek değer yazıp repoya göndermeyin.

ASPNETCORE_ENVIRONMENT=Production

# Coolify'daki PostgreSQL'in "internal" bilgileri. .NET "postgres://..." biçimini okumaz; parçaları buraya yazın.
ConnectionStrings__DefaultConnection=Host=<postgres-iç-adı>;Port=5432;Database=<veritabanı>;Username=<kullanıcı>;Password=<şifre>

# Kendi bilgisayarınızda üretin:  openssl rand -base64 48
JwtSettings__Secret=<en-az-32-karakter>
JwtSettings__Issuer=mutlugunum.com.tr
JwtSettings__Audience=mutlugunum.com.tr

# Kendi bilgisayarınızda üretin:  openssl rand -base64 32
# DİKKAT: İlk kullanıcı kaydolduktan sonra ASLA değiştirmeyin; değişirse kimse giriş yapamaz.
Security__Pepper=<rastgele-deger>

# Açılışta bekleyen migration'ları uygular (il/ilçe ve kategoriler dahil)
Database__MigrateOnStartup=true

Frontend__BaseUrl=https://mutlugunum.com.tr
Cors__AllowedOrigins__0=https://mutlugunum.com.tr
Cors__AllowedOrigins__1=https://www.mutlugunum.com.tr
# Frontend ve API farklı alt alan adlarında: oturum işaretinin frontend'den görünmesi için
Auth__SiteDomain=mutlugunum.com.tr

Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=<gonderen@gmail.com>
Smtp__Password=<gmail-uygulama-sifresi>
Smtp__FromEmail=<gonderen@gmail.com>
Smtp__FromName=Mutlu Günüm

# Swagger arayüzü (/swagger) sunucuda kapalıdır. Denemek için true yapıp Restart edin, iş bitince silin.
# Swagger__Enabled=true

# Yalnızca ilk kurulumda: hiç yönetici yoksa bu hesap yönetici olarak oluşturulur.
# Oluştuktan sonra bu iki satırı silip yeniden başlatın.
Bootstrap__AdminEmail=<yonetici-e-postasi>
Bootstrap__AdminPassword=<en-az-8-karakter-harf-ve-rakam>
